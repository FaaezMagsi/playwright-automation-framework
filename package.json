{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API automation framework for Toolshop using Playwright with JavaScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.46.2",
    "allure-js-commons": "3.15.0",
    "allure-playwright": "3.15.0",
    "dotenv": "^16.4.5"
  }
}
